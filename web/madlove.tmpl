<body>
    <!-- pygbag's download status, kept hidden -->
    <div id="transfer" hidden>
        <div id="status"></div>
        <progress value="0" max="100" id="progress"></progress>
    </div>

    <div id="stage">
        <div id="screen">
            <canvas id="canvas" width="480" height="640" oncontextmenu="event.preventDefault()" tabindex="1"></canvas>
        </div>

        <!-- the control panel, on touch screens -->
        <div id="panel" class="panel-part">
            <div id="stick-zone" aria-label="Stick">
                <div id="stick">
                    <span class="arrow up"></span>
                    <span class="arrow down"></span>
                    <span class="arrow left"></span>
                    <span class="arrow right"></span>
                    <span id="stick-washer"></span>
                    <span id="stick-shaft"></span>
                    <span id="stick-ball"></span>
                </div>
            </div>

            <div id="buttons">
                <!-- on the cabinet's diagonal: Action lower left, Start / Pause upper right -->
                <div id="cluster">
                    <div class="button-cell" id="cell-start" data-button="start" role="button" aria-label="Start / Pause">
                        <span class="arcade-button"><span class="cap"></span></span>
                        <span class="label">Start / Pause</span>
                    </div>
                    <div class="button-cell" id="cell-action" data-button="action" role="button" aria-label="Action">
                        <span class="arcade-button"><span class="cap"></span></span>
                        <span class="label">Action</span>
                    </div>
                </div>
            </div>
        </div>

        <div id="legend"><span><kbd>&larr;</kbd><kbd>&rarr;</kbd> MOVE &middot; <kbd>SPACE</kbd> LAUNCH &middot; <kbd>ENTER</kbd> START &middot; <kbd>ESC</kbd> SMOKE BREAK &middot; <kbd>M</kbd> MUSIC</span></div>
    </div>

    <div id="start">
        <!-- the cabinet turns in black and white and fills with colour from the bottom as the game loads.
             not id="spinner": pygbag hides that one -->
        <div id="loader">
            <img id="loader-bw" src="spinner.webp" alt="">
            <img id="loader-colour" src="spinner.webp" alt="">
        </div>
        <div id="start-text">LOADING</div>
    </div>

    <canvas id="canvas3d" width="1" height="1" hidden></canvas>
    <div id="html"></div>
    <div id="pyconsole" hidden>
        <div id="terminal" tabIndex=1 align="left"></div>
    </div>
    <div id="dlg" hidden>
        <input type="file" id="dlg_multifile" multiple accept="image/*">
    </div>

    <script type="application/javascript">
    async function custom_onload(debug_hidden) {
        // called by pygbag before Python loads. append #debug to the URL to see the Python console
        pyconsole.hidden = debug_hidden
        transfer.hidden = true
    }
    function custom_prerun() {}
    function custom_postrun() {}
    </script>
</body>
