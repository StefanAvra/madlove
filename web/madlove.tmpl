<html lang="en"><script src="{{cookiecutter.cdn}}pythons.js" type=module id="site" data-python="python{{cookiecutter.PYBUILD}}" data-LINES=42 data-COLUMNS=132 data-os="vtx,snd,gui" async defer>#<!--

# MadLove's page for pygbag, based on pygbag 0.9.3's default.tmpl. The Python part below loads and starts
# the game; the HTML part after it is the page: start screen, game screen and the cabinet's control panel,
# styled and driven by madlove.css and madlove.js. crt.js draws the game again through a CRT shader,
# crt-zfast.glsl or crt-geom.glsl. web/build.py copies those next to index.html.

print("Loading {{cookiecutter.title}} from {{cookiecutter.archive}}.apk, pygbag {{cookiecutter.version}}")

import sys
import asyncio
import platform
import json
from pathlib import Path

# do not rename
async def custom_site():
    import embed

    platform.window.transfer.hidden = true
    platform.window.canvas.style.visibility = "visible"

    bundle = "{{cookiecutter.archive}}"

    # the C or js loader could do that but be explicit.
    appdir = Path(f"/data/data/{bundle}")
    appdir.mkdir()

    # madlove.js downloads the compressed archive as soon as the page opens, to show its progress, and
    # writes it to this file when it has it
    archive = f"/tmp/{bundle}.archive"
    saved = 0
    while not saved:
        await asyncio.sleep(.05)
        saved = platform.window.madlove_page.save_archive(archive)
    if saved < 0:
        raise RuntimeError("could not download the game's archive")

    # unpack filesystem from compressed archive into work dir
    if platform.window.location.host.find('.itch.zone')>0:
        import zipfile
        with zipfile.ZipFile(archive) as zip_ref:
            zip_ref.extractall(appdir.as_posix())
    else:
        import tarfile
        with tarfile.open(archive, mode="r:gz") as tar:
            tar.extractall(path=appdir.as_posix(), filter='tar')
    Path(archive).unlink()

    # preloader will change to work dir and prepend it to sys.path
    platform.run_main(PyConfig, loaderhome= appdir / "assets", loadermain=None)

    # wait preloading complete : that includes images and wasm compilation of bundled modules
    while embed.counter()<0:
        await asyncio.sleep(.1)

    main = appdir / "assets" / "main.py"

    # browsers only play sound after the player has clicked, tapped or pressed a key: madlove.js asks for it
    # on the start screen and sets MM.UME then
    if not platform.window.MM.UME:
        __import__(__name__).__file__ = main
        platform.window.madlove_page.ready()
        while not platform.window.MM.UME:
            await asyncio.sleep(.1)

    # start async top level machinery if not started and add a console in any case if requested.
    await TopLevel_async_handler.start_toplevel(platform.shell, console=window.python.config.debug)

    # now that apk is mounted we have access to font cache
    # but we need to fill __file__/__name__ that are not yet set
    __import__(__name__).__file__ = main

    await shell.source(main)

    # if you don't reach that step
    # your main.py has an infinite sync loop somewhere !

    platform.window.madlove_page.started()
    print("madlove.tmpl: done")

    shell.interactive()

asyncio.run( custom_site() )



